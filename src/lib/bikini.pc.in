prefix=${pcfiledir}/@PL_PC_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: bikini
Description: Small, minimal INI reader and writer
URL: https://lab.partoska.com/bikini
Version: @PROJECT_VERSION@
Libs: -L${libdir} -l@PL_LIB_NAME@
Cflags: -I${includedir}
